# Copy to .env and fill in. Password login stays off (openGym's default); people sign in with passkeys.

# The hostname people use to reach openGym. Passkeys are bound to it: never change it later.
RP_ID=gym.example.com
# The full HTTPS address for that hostname.
ORIGIN=https://gym.example.com
# The name shown in the passkey prompt.
RP_NAME=openGym
# The first account that signs up becomes the admin.
FIRST_USER_ADMIN=1
# No anonymous guest accounts.
ALLOW_GUEST=0
# Signing up needs an invite code (ChallengeHouse creates these for you). Leave it 0 until you have created your
# own profile (the first one, the admin), then set it to 1 and run `docker compose up -d` again: with 1 from the
# start nobody can create the first profile.
INVITE_ONLY=0
